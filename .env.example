# ---------------------------------------------------------------------------
# Google Gemini (used by the LEARNER backend for AI features; optional —
# the app falls back to a local linguistic engine when empty)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — SINGLE SOURCE OF TRUTH shared by BOTH backends
# ---------------------------------------------------------------------------
# Public credentials (safe for the browser / Vite frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side credentials (used by the backends)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role key — server-only secret. Lets the ADMIN backend read all rows.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Apps / ports
# ---------------------------------------------------------------------------
# Learner app (server.ts, reads PORT)   -> http://localhost:3030
# Admin app   (admin/server.ts)         -> http://localhost:5000
PORT=3030
ADMIN_PORT=5000

# The Admin Console calls its own backend on the same origin by default.
# Only set this if you host the admin frontend separately from its backend.
VITE_ADMIN_API_URL=

# The Admin Console "Back to learner" link target.
VITE_LEARNER_APP_URL=http://localhost:3030

# Optional comma-separated CORS allowlist for the admin backend.
ADMIN_ALLOWED_ORIGINS=
